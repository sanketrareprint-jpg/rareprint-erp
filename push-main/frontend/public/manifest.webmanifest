      "url": "/orders",
      "description": "Open sales orders"
    },
    {
      "name": "Production",
      "short_name": "Production",
      "url": "/production",
      "description": "Open production tracking"
    },
    {
      "name": "Dispatch",
      "short_name": "Dispatch",
      "url": "/dispatch",
      "description": "Open dispatch"
    },
    {
      "name": "Rate Calculator",
