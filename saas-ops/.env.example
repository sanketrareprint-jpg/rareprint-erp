# Copy this to .env in this same saas-ops/ folder and fill in real values.
# .env is gitignored — never commit real values.

# ── Railway account-level API token ─────────────────────────────────────────
# Generate from your Railway account (not a project-scoped token — creating
# environments/services needs account-wide access). See README.md.
RAILWAY_API_TOKEN=

# ── The ONE dedicated Railway project that holds every customer environment ─
# Create this once, by hand, in the Railway dashboard. Name it something like
# "rareprint-saas-customers" — NOT the same project that runs RarePrint's own
# production backend/frontend. Copy its Project ID here.
RAILWAY_CUSTOMERS_PROJECT_ID=

# ── GitHub source Railway should deploy from, for every customer service ────
# Same repo as RarePrint's own production backend. Root directory is backend/.
GITHUB_REPO=your-github-org/rareprint-erp
BACKEND_ROOT_DIRECTORY=backend

# Root directory for the customer's own Next.js frontend service.
FRONTEND_ROOT_DIRECTORY=frontend

# ── Vercel, for customer frontends ──────────────────────────────────────────
# Customer frontends are Vercel projects, not Railway services: Next.js
# inlines NEXT_PUBLIC_* at build time and Railway does not expose service
# variables to the build step (see lib/vercel-api.js). Create a token at
# vercel.com/account/tokens. VERCEL_TEAM_ID is only needed for a team
# account — leave it blank on a personal account.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
