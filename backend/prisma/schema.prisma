  verifiedBy   User     @relation("CommVerifBy", fields: [verifiedById], references: [id])
  // Bank transaction(s) that paid out this month's commission — set via the
  // Accounts > Commission "Mark as Paid" flow (see BankTransaction.matchedCommissionVerificationId).
  bankTransactions BankTransaction[] @relation("BankTxnCommission")

  @@unique([agentId, year, month])
