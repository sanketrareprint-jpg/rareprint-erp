// ============================================================
// CALL COMPLIANCE — monthly phone-statement call logs cross-checked
// against AiSensy contact-tag exports, to see which agent tagged a
// contact but never actually called them.
// ============================================================

// One row per uploaded Jio (or similar carrier) monthly statement PDF.
// The statement's own phone number (ownerNumber) is auto-matched against
// User.phone to figure out which agent it belongs to; if no user matches,
// rawRows holds the parsed calls until an admin manually assigns an agent.
model CallLogImport {
  id           String    @id @default(cuid())
  fileName     String
  ownerNumber  String? // last-10-digit number found in the statement header
  agentId      String?
  periodStart  DateTime?
  periodEnd    DateTime?
  rowsFound    Int       @default(0)
  rowsImported Int       @default(0)
  rawRows      Json? // parsed { phone, calledAt, durationSec }[] — kept until agent is assigned
  importedById String
  createdAt    DateTime  @default(now())

  agent      User?           @relation("CallLogImportAgent", fields: [agentId], references: [id])
  importedBy User            @relation("CallLogImportedBy", fields: [importedById], references: [id])
  records    CallLogRecord[]

  @@index([agentId])
}

// One row per outgoing call parsed from a statement's itemized voice usage.
model CallLogRecord {
  id          String   @id @default(cuid())
  importId    String
  agentId     String
  phone       String // normalized last-10-digit destination number
  calledAt    DateTime
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())

  import CallLogImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  agent  User          @relation("CallLogRecordAgent", fields: [agentId], references: [id])

  // Guards against double-counting when an agent's overlapping-period
  // statement gets uploaded more than once (e.g. a 1st-15th statement and a
  // later 1st-20th statement both contain the same calls from the 1st-15th).
  // Same agent + same destination number + same exact call timestamp = same
  // call, regardless of which import it came from.
  @@unique([agentId, phone, calledAt])
  @@index([agentId, phone])
  @@index([phone])
  @@index([agentId, calledAt])
}

// One row per uploaded AiSensy "export contacts" CSV.
model ContactImport {
  id           String   @id @default(cuid())
  fileName     String
  rowsFound    Int      @default(0)
  rowsImported Int      @default(0)
  rowsUpdated  Int      @default(0)
  importedById String
  createdAt    DateTime @default(now())

  importedBy User              @relation("ContactImportedBy", fields: [importedById], references: [id])
  contacts   ImportedContact[]

  @@index([importedById])
}

// The current state of an AiSensy contact — upserted by phone on every
// import so re-uploading the same monthly export just refreshes tag/status.
// agentId is resolved from tagRaw by matching User.aisensyTag (case-insensitive).
model ImportedContact {
  id           String    @id @default(cuid())
  importId     String
  name         String?
  phone        String    @unique // normalized last-10-digit number
  tagRaw       String? // raw tag text from the AiSensy export, e.g. "Vaishali"
  agentId      String?
  lastActiveAt DateTime?
  createdOnAt  DateTime?
  source       String?
  status       String? // raw AiSensy contact status (e.g. "active") — NOT the CRM pipeline status below
  optedIn      Boolean?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ── CRM pipeline tracking for the "Not Contacted" tab ──────────────────
  // A not-contacted contact is worked like any other lead: it gets a status
  // and follow-ups. If its phone already matches a real Lead (manually
  // added, CSV-imported, etc.), that Lead is used instead (leadId is set,
  // pipelineStatus/followUps below are then ignored in favor of the Lead's
  // own status/followUps) so we never track the same phone in two places.
  pipelineStatus LeadStatus              @default(NEW)
  leadId         String?
  lead           Lead?                   @relation("ImportedContactLead", fields: [leadId], references: [id], onDelete: SetNull)
  followUps      ImportedContactFollowUp[]

  import ContactImport @relation(fields: [importId], references: [id])
  agent  User?          @relation("ImportedContactAgent", fields: [agentId], references: [id])

  @@index([agentId])
  @@index([tagRaw])
  @@index([leadId])
}

// Mirrors LeadFollowUp, but for a not-contacted AiSensy contact that has no
// matching Lead row yet. Once/if a real Lead exists for that phone, follow-ups
// live on the Lead instead (see ImportedContact.leadId above).
model ImportedContactFollowUp {
  id          String          @id @default(cuid())
  contactId   String
  contact     ImportedContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      FollowUpStatus  @default(PENDING)
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([contactId])
}

// Marketing ROI: one row per calendar month ("2026-07"), holding the ad
// spend the user enters by hand each month. Everything else the ROI tab
// shows (contacts created, converted customers, total sale, total profit)
// is computed on the fly from ImportedContact (createdOnAt, shared with the
// call-compliance AiSensy CSV import above) cross-referenced against
// Customer/Order — no separate contacts table needed here.
model MarketingRoiSpend {
  id           String   @id @default(cuid())
  monthKey     String   @unique // "YYYY-MM"
  metaAdSpend  Decimal  @default(0) @db.Decimal(12, 2)
  aisensySpend Decimal  @default(0) @db.Decimal(12, 2)
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

