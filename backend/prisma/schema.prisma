// ── HR: Employee Master ──────────────────────────────────────────────────
// The single source of truth for pay/attendance calculations. Mirrors the
// old "HR master" table (SR, EMPLOYEE ID, NAME, POST, SALARY, WORKING HOURS,
// PAID LEAVE, PER DAY, PER HR, ADDRESS, MOBILE, JOINING) used by the legacy
// Google Sheet's VLOOKUP-based salary formula.
model Employee {
  id                  String              @id @default(cuid())
  employeeCode        String              @unique // e.g. RP01, internal HR code
  biometricId         String?             @unique // raw ID from the in/out machine export (e.g. "1", "2")
  userId              String?             @unique // linked login account, if any
  fullName            String
  designation         String // "post" in the old sheet, e.g. SELLER, DESIGNER, OFFICE BOY
  department          String?
  status              EmployeeStatus      @default(ACTIVE)

  // Pay basis — read by the salary engine (see SalaryModule)
  baseSalary          Decimal             @db.Decimal(12, 2) // full monthly salary
  workingHoursPerDay  Decimal             @db.Decimal(5, 2)  @default(8) // required hrs/day
  paidLeavePerMonth   Decimal             @db.Decimal(4, 2)  @default(2) // allowed paid leave days/month
  annualPaidLeaveQuota Decimal?           @db.Decimal(5, 2) // optional yearly quota for the leave ledger

  // Registration / master record
  dateOfJoining       DateTime?
  dateOfBirth         DateTime?
  gender              String?
  address             String?
  mobileNumber        String?
  alternateMobile     String?
  emergencyContactName  String?
  emergencyContactPhone String?
  idProofType         String?
  idProofNumber       String?
  bankAccountNumber   String?
  bankIfsc            String?
  photoUrl            String?
  idProofDocUrl       String?
  offerLetterUrl      String?
  notes               String?
  email               String? // for the digital HR agreement link — separate from any login account's email

  // Overtime — some employees are paid for hours beyond their required
  // monthly hours (at the same hourly rate as their base pay), others are not.
  overtimeAllowed     Boolean             @default(false)

  // Master-data approval gate — any admin can add/edit an Employee record,
  // but salary cannot be generated for them until Sanket (checked by email,
  // see SUPERADMIN_EMAIL in hr.service.ts) approves it. Editing any
  // payroll-relevant field resets this back to false.
  masterDataApproved  Boolean             @default(false)
  approvedById        String?
  approvedAt          DateTime?

  // Digital HR agreement — a tokenized link is emailed to the employee; they
  // read the current CompanyTerms and type their name to accept (clickwrap
  // e-signature, no OTP). agreementTermsId freezes which version they saw.
  agreementToken          String?         @unique
  agreementTermsId        String?
  agreementSentAt         DateTime?
  agreementAcceptedAt     DateTime?
  agreementAcceptedIp     String?
  agreementSignatureName  String?

  resignedAt          DateTime?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user                User?               @relation("EmployeeUser", fields: [userId], references: [id])
  approvedBy          User?               @relation("EmployeeApprovedBy", fields: [approvedById], references: [id])
  agreementTerms      CompanyTerms?       @relation(fields: [agreementTermsId], references: [id])
  kras                EmployeeKra[]
  leaveEntries        EmployeeLeaveEntry[]
  attendanceRecords   AttendanceRecord[]

  @@index([status])
}

// Versioned company Terms & Conditions text shown on the digital HR
// agreement page. Creating a new one supersedes the previous "active" one;
// old versions are kept (isActive = false) so past acceptances stay
// auditable against the exact text the employee agreed to.
model CompanyTerms {
  id          String     @id @default(cuid())
  version     Int        @unique
  title       String
  content     String
  isActive    Boolean    @default(true)
  createdById String?
  createdAt   DateTime   @default(now())

  createdBy   User?      @relation("CompanyTermsCreatedBy", fields: [createdById], references: [id])
  employees   Employee[]

  @@index([isActive])
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

// KRA (key result areas) and job responsibilities, tracked per employee.
model EmployeeKra {
  id          String          @id @default(cuid())
  employeeId  String
  type        EmployeeKraType @default(KRA)
