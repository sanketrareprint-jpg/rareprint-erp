  contentHi     String          @db.Text // full topic explanation in Hindi
  scriptEn      String          @db.Text // medicine pouch sales script EN
  scriptHi      String          @db.Text // medicine pouch sales script HI
  keyPoints     String[] // bullet points for quick recap
  difficulty    DifficultyLevel @default(BEGINNER)
  estimatedMins Int             @default(10)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  questions    TopicQuestion[]
  userProgress UserTopicProgress[]
  quizAttempts QuizAttempt[]
}

model TopicQuestion {
  id            String     @id @default(cuid())
  topicId       String
  topic         SalesTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionEn    String
  questionHi    String
  options       Json // { en: [opt1,opt2,opt3,opt4], hi: [opt1,opt2,opt3,opt4] }
  correctIndex  Int // 0-3
  explanationEn String? // shown after answering
  explanationHi String?
  orderIndex    Int        @default(0)
  createdAt     DateTime   @default(now())
}

model UserTopicProgress {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("UserLearning", fields: [userId], references: [id])
  topicId      String
  topic        SalesTopic @relation(fields: [topicId], references: [id])
  topicRead    Boolean    @default(false)
  topicReadAt  DateTime?
  quizPassed   Boolean    @default(false)
  quizPassedAt DateTime?
  quizAttempts Int        @default(0)
  bestScore    Int        @default(0) // out of 5
  isUnlocked   Boolean    @default(false)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
}

model QuizAttempt {
  id            String     @id @default(cuid())
  userId        String
