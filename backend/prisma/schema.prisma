// ── Reward System ────────────────────────────────────────────────────────────
model RewardWallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  coins        Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions RewardTransaction[]
}

model RewardTransaction {
  id             String       @id @default(cuid())
  walletId       String
  coins          Int
  reason         String
  notificationId String?
  orderId        String?
  claimId        String?      // set when this credit came from an approved BonusClaim (see below)
  createdAt      DateTime     @default(now())
  wallet         RewardWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

// ── Bonus Points (activity-based staff rewards) ──────────────────────────────
// Admin defines a catalog of activities worth N points each (e.g. "Get a 5-star
// Google review" = 20 pts). MANUAL activities require the staff member to
// submit a BonusClaim with a required evidence attachment; any ADMIN-role user
// then approves or rejects it from the queue. On approval, points are credited
// via a RewardTransaction against the same RewardWallet used elsewhere in this
// file (userId is a soft reference, same convention as RewardWallet.userId
// above — no FK to User to avoid touching that model's large relation list).
// AUTOMATIC activities skip the claim/approval flow entirely — an admin credits
// them directly (still logged as a BonusClaim with status APPROVED for the
// audit trail, just with no attachment and reviewedById set immediately).
enum BonusClaimType {
  MANUAL
  AUTOMATIC
}

enum BonusClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model BonusActivity {
  id          String         @id @default(cuid())
  name        String
  description String?
  points      Int
  claimType   BonusClaimType @default(MANUAL)
  isActive    Boolean        @default(true)
  createdById String?        // soft reference to User.id
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  claims      BonusClaim[]

  @@index([isActive])
}

model BonusClaim {
  id             String            @id @default(cuid())
  activityId     String
  userId         String            // soft reference to User.id — the claimant
  points         Int               // snapshot of BonusActivity.points at claim/credit time
  details        String            // claimant's write-up of what they did
  attachmentUrl  String?           // base64 data URI, same "DB is source of truth" convention as ComplaintAttachment
  attachmentName String?
  attachmentType String?
  status         BonusClaimStatus  @default(PENDING)
  reviewedById   String?           // soft reference to User.id — the approving/rejecting admin
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  activity       BonusActivity     @relation(fields: [activityId], references: [id])

  @@index([userId, status])
  @@index([status])
  @@index([activityId])
}

// ── Customer Loyalty Points ──────────────────────────────────────────────────
// Keyed by normalized phone number, not customerId — Customer has no unique
// constraint on phone, and staff sometimes create a new customer record for
// a repeat buyer. This survives duplicate customer records and walk-in
// re-entries. Distinct from RewardWallet/RewardTransaction above, which are
// staff-facing coin rewards keyed on User.id — a different concept.
enum LoyaltyTxnType {
  EARN
  REDEEM
  REVERSE
  ADJUST
}

model CustomerLoyaltyWallet {
  id           String                        @id @default(cuid())
  phone        String                        @unique // normalized, e.g. 91XXXXXXXXXX
  customerId   String?                       // soft reference, last known Customer
  points       Int                           @default(0)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  transactions CustomerLoyaltyTransaction[]

  @@index([customerId])
}

model CustomerLoyaltyTransaction {
  id          String                 @id @default(cuid())
  walletId    String
  orderId     String?
  type        LoyaltyTxnType
  points      Int                    // + for EARN, − for REDEEM/REVERSE
  baseAmount  Decimal?               @db.Decimal(14, 2)
  grossProfit Decimal?               @db.Decimal(14, 2)
  discountPct Decimal?               @db.Decimal(5, 2)
  reason      String?
  createdAt   DateTime               @default(now())
  wallet      CustomerLoyaltyWallet  @relation(fields: [walletId], references: [id])

  @@unique([orderId, type]) // one EARN / one REDEEM / one REVERSE per order
  @@index([walletId])
}

model Notification {
  id          String    @id @default(cuid())
  type        String
  title       String
  message     String
  orderId     String?
  orderNo     String?
  itemId      String?
  sheetId     String?
  jobWorkId   String?
  toUserId    String
  toUserName  String
  fromSystem  Boolean   @default(true)
  isRead      Boolean   @default(false)
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  explanation String?
  actionTaken String?
  copyToAdmin Boolean   @default(false)
  adminSeen   Boolean   @default(false)
  priority    String    @default("NORMAL")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([toUserId, isResolved])
  @@index([toUserId, isRead])
  @@index([toUserId, createdAt])
  @@index([copyToAdmin, createdAt])
  @@index([type, isResolved])
  @@index([orderId])
}

// ── Paper Inventory ───────────────────────────────────────────────────────────

/// A paper purchase order — can be created from an uploaded invoice image (AI-extracted)
model PaperPurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique // auto e.g. PPO-2025-001
  invoiceNumber    String? // read from invoice image
  invoiceImagePath String? // stored file path
  supplierId       String? // optional paper supplier (Vendor)
  status           PaperPOStatus       @default(DRAFT)
  notes            String?
  isVerified       Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  items            PaperPurchaseItem[]
  supplier         Vendor?             @relation("POSupplier", fields: [supplierId], references: [id])
}

/// Each line item in a paper PO — one row per paper type, assigned to a specific press
model PaperPurchaseItem {
  id            String             @id @default(cuid())
  poId          String
  paperName     String // e.g. "Maplitho 70 GSM 18x23"
  gsm           Int
  quality       SheetQuality
  sizeInches    String?
  unit          PaperUnit // REAM or PACKET
  unitQuantity  Float // number of reams or packets purchased
  sheetsPerUnit Int // 500 for REAM; user-entered for PACKET (100/125/250)
  totalSheets   Int // computed: unitQuantity * sheetsPerUnit
  pressId       String // which press this paper is allocated to
  createdAt     DateTime           @default(now())
  po            PaperPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  press         Vendor             @relation("PaperItemPress", fields: [pressId], references: [id])
  transactions  PaperTransaction[]

  @@index([poId])
  @@index([pressId, gsm, quality])
}

/// Running balance of paper at each press, per GSM + quality combination
model PaperInventory {
  id            String       @id @default(cuid())
  pressId       String
  gsm           Int
  quality       SheetQuality
  balanceSheets Int          @default(0) // always in individual sheet count
  updatedAt     DateTime     @updatedAt
  press         Vendor       @relation("PressInventory", fields: [pressId], references: [id])

  @@unique([pressId, gsm, quality])
  @@index([pressId])
}

/// Full ledger of all paper movements (purchases IN, printing deductions OUT)
model PaperTransaction {
  id              String               @id @default(cuid())
  pressId         String
  gsm             Int
  quality         SheetQuality
  transactionType PaperTransactionType
  sheets          Int // positive = IN (purchase), negative = OUT (consumed)
  balanceAfter    Int // snapshot of balance after this transaction
  referenceId     String? // sheetId or poItemId
  referenceType   String? // 'PURCHASE' | 'PRINT_SHEET'
  notes           String?
  purchaseItemId  String?
  createdAt       DateTime             @default(now())
  purchaseItem    PaperPurchaseItem?   @relation(fields: [purchaseItemId], references: [id])
  press           Vendor               @relation("PressTransactions", fields: [pressId], references: [id])

  @@index([pressId, gsm, quality, createdAt])
  @@index([referenceId])
}

// ── WhatsApp Campaign Marketing Automation ─────────────────────────────────

