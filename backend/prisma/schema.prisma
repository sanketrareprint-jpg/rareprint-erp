generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id @default(cuid())
  fullName           String
  email              String                @unique
  phone              String?
  passwordHash       String
  passwordResetToken      String?               @unique
  passwordResetExpiresAt  DateTime?
  role               UserRole
  salesAgentCategory SalesAgentCategory?
  baseSalary         Decimal?              @db.Decimal(12, 2)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  commissions        Commission[]          @relation("CommissionSalesAgent")
  ordersAsAgent      Order[]               @relation("OrderSalesAgent")
  paymentsReceived   Payment[]             @relation("PaymentReceivedBy")
  paymentsVerified   Payment[]             @relation("PaymentVerifiedBy")
  productionJobs     ProductionJob[]       @relation("ProductionAssignedTo")
  shipmentsHandled   Shipment[]            @relation("ShipmentHandledBy")
  statusLogsCreated  StatusLog[]           @relation("StatusChangedBy")
  itemStageLogs      ItemStageLog[]        @relation("ItemStageChangedBy")
  tasksCreated       Task[]                @relation("TaskCreatedBy")
  tasksAssigned      Task[]                @relation("TaskAssignedTo")
  agentLeads         Lead[]                @relation("AgentLeads")
  leadActivities     LeadActivity[]        @relation("ActivityCreator")
  learningProgress   UserTopicProgress[]   @relation("UserLearning")
  quizAttempts       QuizAttempt[]         @relation("UserQuizAttempts")
  milestoneAttempts  MilestoneAttempt[]    @relation("UserMilestoneAttempts")
  learningStreaks    DailyLearningStreak[] @relation("UserStreak")
  callAnalyses       CallAnalysis[]        @relation("UserCallAnalyses")
  marketingContacts  MarketingContact[]    @relation("MarketingContactAgent")
  marketingCampaigns MarketingCampaign[]   @relation("MarketingCampaignCreator")
  bankImports               BankImportSession[]        @relation("BankImports")
  bankTxnReconciled         BankTransaction[]          @relation("BankTxnReconciledBy")
  bankTxnChecked            BankTransaction[]          @relation("BankTxnCheckedBy")
  bankTxnRechecked          BankTransaction[]          @relation("BankTxnRecheckedBy")
  bankTxnSalaryFor          BankTransaction[]          @relation("BankTxnSalaryFor")
  commissionsVerified       CommissionVerification[]   @relation("CommVerifBy")
  commissionVerifications   CommissionVerification[]   @relation("CommVerifAgent")
  activitySessions          UserActivitySession[]       @relation("UserActivitySessions")
  commissionOverridesReceived CommissionOverride[]      @relation("CommOverrideAgent")
  commissionOverridesSet      CommissionOverride[]      @relation("CommOverrideSetBy")
  remittanceImports           RemittanceImportSession[] @relation("RemittanceImports")
  remittancePosted            RemittanceRecord[]        @relation("RemittancePostedBy")
  employeeProfile              Employee?                 @relation("EmployeeUser")
  employeeLeavesRecorded       EmployeeLeaveEntry[]      @relation("LeaveRecordedBy")
  attendanceRecordsEdited      AttendanceRecord[]        @relation("AttendanceEditedBy")
  attendanceImports            AttendanceImportSession[] @relation("AttendanceImports")
  employeesApproved            Employee[]                @relation("EmployeeApprovedBy")
  companyTermsCreated          CompanyTerms[]            @relation("CompanyTermsCreatedBy")
  complaintsRaised              Complaint[]               @relation("ComplaintRaisedBy")
  complaintsAssigned             Complaint[]               @relation("ComplaintAssignedTo")
  paymentKeywords                UserPaymentKeyword[]      @relation("UserPaymentKeywords")

  // ── Call Compliance (monthly call-log + AiSensy tag cross-check) ──────────
  aisensyTag           String?                 // this agent's tag name as used in AiSensy contact exports (e.g. "Vaishali")
  callLogImportsOwned  CallLogImport[]         @relation("CallLogImportAgent")
  callLogImportsMade   CallLogImport[]         @relation("CallLogImportedBy")
  callLogRecords       CallLogRecord[]         @relation("CallLogRecordAgent")
  contactImportsMade   ContactImport[]         @relation("ContactImportedBy")
  importedContacts     ImportedContact[]       @relation("ImportedContactAgent")
}

model Customer {
  id               String                  @id @default(cuid())
  customerCode     String                  @unique
  businessName     String
  contactPerson    String?
  email            String?
  phone            String?
  phone2           String?
  gstNumber        String?
  billingAddress   String?
  shippingAddress  String?
  city             String?
  state            String?
  pincode          String?
  creditLimit      Decimal?                @db.Decimal(12, 2)
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  orders           Order[]
  ledgerEntries    AccountingLedgerEntry[]
  creditDebitNotes AccountingNote[]
  complaints       Complaint[]
}

model ProductCategory {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  commissionRules CommissionRule[]
  products        Product[]
}

model Product {
  id                 String            @id @default(cuid())
  sku                String            @unique
  name               String
  description        String?
  categoryId         String
  gsm                Int
  paperType          String? // e.g. "Bond", "Maplitho", "Art", "Ivory", "Kraft"
  sizeInches         String
  openSizeInches     String? // e.g. "4x5" open flat size for sheet calc
  printingType       PrintingType
  sides              ProductSides
  weightPerUnitGrams Decimal?          @db.Decimal(10, 3)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  commissionRules    CommissionRule[]
  orderItems         OrderItem[]
  category           ProductCategory   @relation(fields: [categoryId], references: [id])
  costSlabs          ProductCostSlab[]
  rateSlabs          ProductRateSlab[]
  sheetItems         PrintSheetItem[]
  productRule        ProductRule?
}

model OfferCode {
  id             String      @id @default(cuid())
  code           String      @unique
  description    String?
  offerType      String      @default("FREE_ITEM")  // FREE_ITEM | COMBO_DISCOUNT
  discountAmount Decimal?    @db.Decimal(12, 2)     // total discount for COMBO_DISCOUNT
  notes          String?                            // internal notes for accounts team
  productIds     String[]    // products this code is valid for
  validFrom      DateTime?
  validTo        DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
}

model ProductRule {
  id        String   @id @default(cuid())
  productId String   @unique
  minQty    Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductCostSlab {
  id            String    @id @default(cuid())
  productId     String
  minQuantity   Int
  maxQuantity   Int?
  unitPrice     Decimal   @db.Decimal(12, 2)
  setupCost     Decimal?  @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, minQuantity, maxQuantity])
}

model ProductRateSlab {
  id            String    @id @default(cuid())
  productId     String
  minQuantity   Int
  maxQuantity   Int?
  rateAmount    Decimal   @db.Decimal(12, 2) // total selling rate for this quantity tier
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, minQuantity, maxQuantity])
}

model CommissionRule {
  id             String           @id @default(cuid())
  name           String
  productId      String?
  categoryId     String?
  applicableRole UserRole         @default(SALES_AGENT)
  commissionPct  Decimal          @db.Decimal(5, 2)
  effectiveFrom  DateTime         @default(now())
  effectiveTo    DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  commissions    Commission[]
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  product        Product?         @relation(fields: [productId], references: [id])

  @@index([productId, categoryId, effectiveFrom, effectiveTo])
}

model PaymentAccount {
  id             String          @id @default(cuid())
  name           String
  accountType    String
  accountNumber  String?
  bankName       String?
  ifscCode       String?
  upiId          String?
  openingBalance Decimal?        @db.Decimal(14, 2)
  currentBalance Decimal?        @db.Decimal(14, 2)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  payments       Payment[]
  vendorPayments VendorPayment[]
}

// ── Vendor model for Clubbing / jobwork ──────────────────────────────────────
model Vendor {
  id                  String                  @id @default(cuid())
  name                String
  phone               String?
  email               String?
  address             String?
  gstNumber           String?
  isActive            Boolean                 @default(true)
  isPress             Boolean                 @default(false) // true = this vendor is a printing press
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  jobWorks            JobWork[]
  sheetStages         SheetStageVendor[]
  paperPurchaseItems  PaperPurchaseItem[]     @relation("PaperItemPress")
  paperInventory      PaperInventory[]        @relation("PressInventory")
  paperTransactions   PaperTransaction[]      @relation("PressTransactions")
  paperPurchaseOrders PaperPurchaseOrder[]    @relation("POSupplier")
  bankTransactions    BankTransaction[]       @relation("BankTxnVendor")
  vendorKeywords      VendorKeyword[]         @relation("VendorKeywords")
  purchaseBills       PurchaseBill[]
  vendorPayments      VendorPayment[]
  ledgerEntries       AccountingLedgerEntry[]
  creditDebitNotes    AccountingNote[]
  complaints          Complaint[]
}

// ── JobWork: Clubbing sub-category vendor assignment per order item ───────────
model JobWork {
  id              String        @id @default(cuid())
  poNumber        String?       @unique // auto-generated e.g. JW-2025-001
  orderItemId     String
  vendorId        String
  description     String
  cost            Decimal       @db.Decimal(12, 2)
  vendorInvoiceNo String?
  status          JobWorkStatus @default(PENDING)
  isPaid          Boolean       @default(false)
  paidAt          DateTime?
  completedAt     DateTime?
  dueDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
}

// ── PrintSheet: Sheet Production ────────────────────────────────────────────
model PrintSheet {
  id                    String             @id @default(cuid())
  sheetNo               String             @unique // auto-generated e.g. SHT-2024-001
  gsm                   Int
  quality               SheetQuality
  quantity              Int
  actualPrintedQuantity Int?
  sizeInches            String // e.g. "18x23"
  areaSqInches          Float // computed: width * height
  printing              ProductSides
  status                SheetStatus        @default(INCOMPLETE)
  usedAreaSqInches      Float              @default(0)
  createdBySource       String             @default("MANUAL")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  items                 PrintSheetItem[]
  stageVendors          SheetStageVendor[]

  @@index([status, updatedAt])
  @@index([gsm, status])
}

// ── Items placed on a sheet ──────────────────────────────────────────────────
model PrintSheetItem {
  id                   String     @id @default(cuid())
  sheetId              String
  orderItemId          String
  productId            String
  multiple             Int // how many times this item fits on sheet
  quantityOnSheet      Int // quantity covered by this sheet placement
  areaSqInches         Float // open size area * multiple
  dueDate              DateTime?
  processingVendorName String?
  createdAt            DateTime   @default(now())
  sheet                PrintSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  orderItem            OrderItem  @relation(fields: [orderItemId], references: [id])
  product              Product    @relation(fields: [productId], references: [id])

  @@index([sheetId])
  @@index([orderItemId])
  @@index([productId])
}

// ── Stage-wise vendors for sheet production ──────────────────────────────────
model SheetStageVendor {
  id              String               @id @default(cuid())
  sheetId         String
  stage           SheetProductionStage
  vendorId        String
  description     String?
  cost            Decimal              @db.Decimal(12, 2)
  vendorInvoiceNo String?
  isPaid          Boolean              @default(false)
  paidAt          DateTime?
  createdAt       DateTime             @default(now())
  sheet           PrintSheet           @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  vendor          Vendor               @relation(fields: [vendorId], references: [id])
}

// ── ItemStageLog: full history of each item's stage changes ─────────────────
model ItemStageLog {
  id          String                @id @default(cuid())
  orderItemId String
  fromStage   OrderProductionStage?
  toStage     OrderProductionStage
  changedById String?
  note        String?
  createdAt   DateTime              @default(now())
  orderItem   OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  changedBy   User?                 @relation("ItemStageChangedBy", fields: [changedById], references: [id])

  @@index([orderItemId, createdAt])
}

model Godown {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  address        String?
  city           String?
  state          String?
  pincode        String?
  contactPerson  String?
  phone          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productionJobs ProductionJob[]
  shipments      Shipment[]
}

model Order {
  id               String                  @id @default(cuid())
  orderNumber      String                  @unique
  customerId       String
  salesAgentId     String?
  orderDate        DateTime                @default(now())
  expectedDelivery DateTime?
  status           OrderStatus             @default(DRAFT)
  paymentStatus    PaymentStatus           @default(PENDING)
  subtotal         Decimal                 @db.Decimal(14, 2)
  discount         Decimal                 @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal                 @default(0) @db.Decimal(14, 2)
  shippingCharge   Decimal                 @default(0) @db.Decimal(14, 2)
  grandTotal       Decimal                 @db.Decimal(14, 2)
  notes            String?
  leadSource       String? // e.g. "WALK_IN", "FB_AD_Jan_2025"
  isTest           Boolean                 @default(false)
  isSample         Boolean                 @default(false)
  samplePaymentType String?               // "PREPAID" | "COD" — set by accounts on approval
  loyaltyPointsEarned    Int?              // points credited on invoicing (see CustomerLoyaltyTransaction)
  loyaltyPointsRedeemed  Int?              // points redeemed against this bill
  loyaltyDiscountAmount  Decimal?          @db.Decimal(12, 2) // ₹ value of redeemed points — excluded from `discount` on purpose
  requestedLoyaltyRedemption Int?          // sales agent's requested redeem amount, captured at order creation;
                                            // actually applied via LoyaltyService.redeemForOrder once accounts approves
                                            // the order and the invoice exists (see AccountsService.approveOrder)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  productionStage  OrderProductionStage    @default(NOT_PRINTED)
  commissions      Commission[]
  invoice          Invoice?
  ledgerEntries    AccountingLedgerEntry[]
  customer         Customer                @relation(fields: [customerId], references: [id])
  salesAgent       User?                   @relation("OrderSalesAgent", fields: [salesAgentId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  productionJobs   ProductionJob[]
  shipments        Shipment[]
  statusLogs       StatusLog[]
  reassuranceLogs  OrderReassuranceLog[]
  remittanceMatches   RemittanceRecord[]  @relation("RemittanceMatchedOrder")
  remittanceSuggested RemittanceRecord[]  @relation("RemittanceSuggestedOrder")
  complaints          Complaint[]

  @@index([status, orderDate])
  @@index([status, updatedAt])
  @@index([salesAgentId, orderDate])
  @@index([customerId, orderDate])
  @@index([productionStage])
}

model OrderItem {
  id                  String               @id @default(cuid())
  orderId             String
  productId           String
  quantity            Int
  unitPrice           Decimal              @db.Decimal(12, 2)
  lineDiscount        Decimal              @default(0) @db.Decimal(12, 2)
  taxRatePct          Decimal              @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal              @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal              @db.Decimal(14, 2)
  artworkNotes        String?
  productionNotes     String?
  designFiles         Json                 @default("[]")
  productionCategory  ProductionCategory? // INHOUSE | CLUBBING | SHEET_PRODUCTION
  itemProductionStage OrderProductionStage @default(NOT_PRINTED)
  processingFollowUpDate DateTime?
  offerCodeId         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id])
  offerCode           OfferCode?           @relation(fields: [offerCodeId], references: [id])
  stageLogs           ItemStageLog[]
  jobWorks            JobWork[]
  sheetItems          PrintSheetItem[]
  commissionOverride  CommissionOverride?

  @@index([orderId, productId])
  @@index([itemProductionStage, updatedAt])
  @@index([productionCategory, itemProductionStage])
}

model Payment {
  id                 String                    @id @default(cuid())
  orderId            String
  paymentAccountId   String
  receivedById       String?
  paymentDate        DateTime                  @default(now())
  amount             Decimal                   @db.Decimal(14, 2)
  method             PaymentMethod
  referenceNumber    String?
  notes              String?
  verificationStatus PaymentVerificationStatus @default(PENDING_VERIFICATION)
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  verifiedBy         User?                     @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  order              Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAccount     PaymentAccount            @relation(fields: [paymentAccountId], references: [id])
  receivedBy         User?                     @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  bankTransactions   BankTransaction[]         @relation("BankTxnPayment")
  remittanceRecord   RemittanceRecord?         @relation("RemittancePostedPayment")

  @@index([orderId, verificationStatus])
  @@index([paymentDate])
}

model Invoice {
  id               String                  @id @default(cuid())
  orderId          String                  @unique
  invoiceNumber    String                  @unique
  issueDate        DateTime                @default(now())
  dueDate          DateTime?
  subtotal         Decimal                 @db.Decimal(14, 2)
  discountAmount   Decimal                 @default(0) @db.Decimal(14, 2)
  taxableAmount    Decimal                 @default(0) @db.Decimal(14, 2)
  cgstAmount       Decimal                 @default(0) @db.Decimal(14, 2)
  sgstAmount       Decimal                 @default(0) @db.Decimal(14, 2)
  igstAmount       Decimal                 @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal                 @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal                 @db.Decimal(14, 2)
  paidAmount       Decimal                 @default(0) @db.Decimal(14, 2)
  balanceAmount    Decimal                 @db.Decimal(14, 2)
  gstTreatment     GstTreatment            @default(INTRA_STATE)
  status           InvoiceStatus           @default(ISSUED)
  whatsappStatus   WhatsAppDeliveryStatus  @default(PENDING)
  whatsappSentAt   DateTime?
  whatsappError    String?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items            InvoiceItem[]
  ledgerEntries    AccountingLedgerEntry[]
  creditDebitNotes AccountingNote[]
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  productName    String
  sku            String?
  hsnSac         String?
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal @db.Decimal(14, 2)
  gstRatePct     Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(14, 2)
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PurchaseBill {
  id               String                  @id @default(cuid())
  vendorId         String
  billNumber       String
  billDate         DateTime                @default(now())
  dueDate          DateTime?
  subtotal         Decimal                 @db.Decimal(14, 2)
  taxableAmount    Decimal                 @db.Decimal(14, 2)
  cgstAmount       Decimal                 @default(0) @db.Decimal(14, 2)
  sgstAmount       Decimal                 @default(0) @db.Decimal(14, 2)
  igstAmount       Decimal                 @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal                 @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal                 @db.Decimal(14, 2)
  paidAmount       Decimal                 @default(0) @db.Decimal(14, 2)
  balanceAmount    Decimal                 @db.Decimal(14, 2)
  gstTreatment     GstTreatment            @default(INTRA_STATE)
  status           PurchaseBillStatus      @default(OPEN)
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  vendor           Vendor                  @relation(fields: [vendorId], references: [id])
  payments         VendorPayment[]
  ledgerEntries    AccountingLedgerEntry[]
  creditDebitNotes AccountingNote[]

  @@unique([vendorId, billNumber])
  @@index([vendorId, billDate])
  @@index([status, dueDate])
}

model VendorPayment {
  id               String         @id @default(cuid())
  vendorId         String
  purchaseBillId   String?
  paymentAccountId String
  paymentDate      DateTime       @default(now())
  amount           Decimal        @db.Decimal(14, 2)
  method           PaymentMethod
  referenceNumber  String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  vendor           Vendor         @relation(fields: [vendorId], references: [id])
  purchaseBill     PurchaseBill?  @relation(fields: [purchaseBillId], references: [id])
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id])

  @@index([vendorId, paymentDate])
  @@index([purchaseBillId])
}

model AccountingLedgerEntry {
  id             String          @id @default(cuid())
  entryDate      DateTime        @default(now())
  entryType      LedgerEntryType
  accountName    String
  debitAmount    Decimal         @default(0) @db.Decimal(14, 2)
  creditAmount   Decimal         @default(0) @db.Decimal(14, 2)
  narration      String?
  referenceType  String
  referenceId    String
  customerId     String?
  vendorId       String?
  orderId        String?
  invoiceId      String?
  purchaseBillId String?
  createdAt      DateTime        @default(now())
  customer       Customer?       @relation(fields: [customerId], references: [id])
  vendor         Vendor?         @relation(fields: [vendorId], references: [id])
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseBill   PurchaseBill?   @relation(fields: [purchaseBillId], references: [id])

  @@index([entryDate])
  @@index([accountName, entryDate])
  @@index([customerId, entryDate])
  @@index([vendorId, entryDate])
  @@index([referenceType, referenceId])
}

model AccountingNote {
  id             String               @id @default(cuid())
  noteNumber     String               @unique
  noteType       AccountingNoteType
  partyType      AccountingPartyType
  customerId     String?
  vendorId       String?
  invoiceId      String?
  purchaseBillId String?
  noteDate       DateTime             @default(now())
  reason         String
  taxableAmount  Decimal              @db.Decimal(14, 2)
  cgstAmount     Decimal              @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal              @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal              @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal              @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal              @db.Decimal(14, 2)
  status         AccountingNoteStatus @default(ISSUED)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  customer       Customer?            @relation(fields: [customerId], references: [id])
  vendor         Vendor?              @relation(fields: [vendorId], references: [id])
  invoice        Invoice?             @relation(fields: [invoiceId], references: [id])
  purchaseBill   PurchaseBill?        @relation(fields: [purchaseBillId], references: [id])

  @@index([noteType, noteDate])
  @@index([customerId, noteDate])
  @@index([vendorId, noteDate])
}

model Commission {
  id               String          @id @default(cuid())
  orderId          String
  salesAgentId     String
  commissionRuleId String?
  commissionPct    Decimal         @db.Decimal(5, 2)
  commissionBase   Decimal         @db.Decimal(14, 2)
  commissionAmount Decimal         @db.Decimal(14, 2)
  isSettled        Boolean         @default(false)
  settledAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  commissionRule   CommissionRule? @relation(fields: [commissionRuleId], references: [id])
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
