}

// One row per employee per calendar day, sourced from the biometric machine's
// "Exception Stat." export (ID, Name, Date, On-duty, Off-duty, Late/Early/
// Absence minutes) or entered/corrected by hand when the thumb reader misses
// a punch. hoursWorked is stored (not just derived) so a manual edit always
// wins and the salary engine never has to re-parse raw punches.
model AttendanceRecord {
  id               String              @id @default(cuid())
  employeeId       String
  date             DateTime            @db.Date
  timeIn           String? // "HH:MM", 24h, first punch of the day
  timeOut          String? // "HH:MM", 24h, last punch of the day
  secondTimeIn     String? // split-shift second half (e.g. post-lunch)
  secondTimeOut    String?
  hoursWorked      Decimal             @db.Decimal(5, 2) @default(0)
  lateMinutes      Int?
  earlyLeaveMinutes Int?
  isAbsent         Boolean             @default(false)
  isPaidLeave      Boolean             @default(false) // marked as covered by leave ledger, not a deduction
  source           AttendanceSource    @default(IMPORTED)
  note             String?
  editedById       String? // set whenever a human overrides the imported value
  importSessionId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  editedBy         User?               @relation("AttendanceEditedBy", fields: [editedById], references: [id])
  importSession    AttendanceImportSession? @relation(fields: [importSessionId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
}

enum AttendanceSource {
  IMPORTED // straight from the machine export
  MANUAL   // no punch at all, entered by hand
  EDITED   // machine had a value, a human corrected it
}

model AttendanceImportSession {
  id           String             @id @default(cuid())
  fileName     String
  periodStart  DateTime           @db.Date
  periodEnd    DateTime           @db.Date
  importedById String
  rowsFound    Int                @default(0)
  rowsImported Int                @default(0)
