}

// Leave ledger — individual leave events. Balance = annualPaidLeaveQuota
// (or paidLeavePerMonth × months elapsed) minus sum of PAID entries.
model EmployeeLeaveEntry {
  id             String    @id @default(cuid())
  employeeId     String
  date           DateTime
  endDate        DateTime?
  days           Decimal   @db.Decimal(4, 2) @default(1)
  type           LeaveType @default(PAID)
