// ══════════════════════════════════════════════════════════════════════════════
// BANK STATEMENT MODULE
// ══════════════════════════════════════════════════════════════════════════════

model BankImportSession {
  id              String            @id @default(cuid())
  accountNumber   String
  fileName        String
  importedById    String
  rowsFound       Int               @default(0)
  rowsImported    Int               @default(0)
  rowsSkipped     Int               @default(0)
  lastSrlImported Int?
  lastBalance     Decimal?          @db.Decimal(14, 2)
  status          BankImportStatus  @default(PROCESSING)
  errorMessage    String?
  createdAt       DateTime          @default(now())
  importedBy      User              @relation("BankImports", fields: [importedById], references: [id])
  transactions    BankTransaction[]

  @@index([accountNumber, createdAt])
}

model BankTransaction {
  id                String              @id @default(cuid())
  sessionId         String
  accountNumber     String
  importKey         String
  srl               Int
  txnDate           DateTime
  txnDateTime       DateTime?
  valueDate         DateTime
  description       String
  chequeNo          String?
  crDr              BankTxnType
  amount            Decimal             @db.Decimal(14, 2)
  balance           Decimal             @db.Decimal(14, 2)
  reconcileStatus   BankReconcileStatus @default(UNMATCHED)
  matchedPaymentId  String?
  matchedVendorId   String?
  expenseCategoryId String?
  matchedCommissionVerificationId String?
  reviewNote        String?
  reconciledAt      DateTime?
  reconciledById    String?

  // ── Accounts > Payment Verification workflow ──────────────────────────────
  // Every matched/needs-review DEBIT bank entry surfaces in the Accounts >
  // Payment Verification queue. An accountant/admin adds an optional note and
  // clicks "Checked" (one-way — cannot be undone by them). Once checked, only
  // the super-admin (Sanket) sees a "Rechecked" action, which stamps
  // recheckedById/recheckedAt and moves the entry out of the queue into
  // Accounts > Payment History. See AccountsService.getPaymentVerificationQueue.
  accountantNote    String?
  checkedById       String?
  checkedAt         DateTime?
  recheckedById     String?
  recheckedAt       DateTime?
  // Free-text override for the Vendor/Expense column (lighter than picking a
  // linked Vendor/ExpenseCategory record — this is just a display label for
  // the verification screen) and the accounting month an expense applies to,
  // for cases like rent paid in July that actually belongs to June.
  vendorExpenseOverride String?
  expensePeriod     DateTime?

  // ── Expense Tracker: "tag this withdrawal as a salary payment" ───────────
  // Lets Accounts > Expense Tracker mark a DR transaction as the salary
  // payout for a specific user (regular staff, or Sanket himself) for a
  // given calendar month/year. Salary has no other "paid" record anywhere
  // (it's calculated live off Employee attendance) — this is the only place
  // a salary payment is ever actually recorded as paid. For Sanket, who has
  // no fixed monthly salary figure, his accrued "salary expense" for a
  // month IS simply the sum of transactions tagged here for that month —
  // see ExpenseTrackerService. New MATCHED_SALARY reconcile status, same
  // convention as MATCHED_COMMISSION/MATCHED_VENDOR/MATCHED_EXPENSE.
  salaryForUserId   String?
  salaryYear        Int?
  salaryMonth       Int?      // 1-12, matches HR salary engine's convention

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  session           BankImportSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matchedPayment    Payment?            @relation("BankTxnPayment", fields: [matchedPaymentId], references: [id])
  matchedVendor     Vendor?             @relation("BankTxnVendor", fields: [matchedVendorId], references: [id])
  expenseCategory   ExpenseCategory?    @relation(fields: [expenseCategoryId], references: [id])
  matchedCommissionVerification CommissionVerification? @relation("BankTxnCommission", fields: [matchedCommissionVerificationId], references: [id])
  reconciledBy      User?               @relation("BankTxnReconciledBy", fields: [reconciledById], references: [id])
  checkedBy         User?               @relation("BankTxnCheckedBy", fields: [checkedById], references: [id])
  recheckedBy       User?               @relation("BankTxnRecheckedBy", fields: [recheckedById], references: [id])
  salaryForUser     User?               @relation("BankTxnSalaryFor", fields: [salaryForUserId], references: [id])

  @@unique([accountNumber, importKey])
  @@index([recheckedAt])
  @@index([accountNumber, txnDate])
  @@index([reconcileStatus])
  @@index([txnDate])
  @@index([salaryForUserId, salaryYear, salaryMonth])
}

// ─── Courier COD Remittance Import ─────────────────────────────────────────
// Reconciles two courier-exported reports (e.g. Bigship "Remittance Report" +
// "Delivered Orders Report") joined by AWB number, resolves each remittance
// row to an ERP Order, and posts a Payment (receipt) that adjusts the order's
// balance. See RemittanceService for the matching logic.

model RemittanceImportSession {
  id                 String             @id @default(cuid())
  fileName           String // remittance report file name
  deliveredFileName  String? // delivered-orders report file name
  importedById       String
  rowsFound          Int                @default(0)
  rowsMatched        Int                @default(0)
  rowsNeedReview     Int                @default(0)
  rowsDuplicate      Int                @default(0)
  rowsPosted         Int                @default(0)
  createdAt          DateTime           @default(now())
  importedBy         User               @relation("RemittanceImports", fields: [importedById], references: [id])
  records            RemittanceRecord[]

  @@index([createdAt])
}

model RemittanceRecord {
  id                String                @id @default(cuid())
  sessionId         String
  importKey         String                @unique // hash(awbNumber + remittanceDate + netPayableAmount)

  // From the courier's Remittance Report
  remittanceRef     String? // e.g. Bigship RemittanceId
  awbNumber         String
  courierName       String?
  lrNumber          String?
  deliveryDate      DateTime?
  remittanceDate    DateTime?
  collectableAmount Decimal               @db.Decimal(14, 2)
  earlyCodAmount    Decimal?              @db.Decimal(14, 2)
  otherDeduction    Decimal?              @db.Decimal(14, 2)
  netPayableAmount  Decimal               @db.Decimal(14, 2)
  remittanceStatus  String?

  // Joined in from the Delivered Orders Report by AWB number
  channelOrderId    String? // candidate ERP orderNumber, taken from "Channel Order Id / Invoice Number"
  receiverName      String?
  receiverMobile    String?
  productDetails    String?

  // Matching
  matchStatus       RemittanceMatchStatus @default(NEEDS_REVIEW)
  matchMethod        String? // ORDER_NUMBER | SHIPMENT_AWB | PHONE_SUGGESTED | MANUAL
  matchedOrderId     String?
  suggestedOrderId   String? // best-guess order when matchStatus = NEEDS_REVIEW, for the reviewer to confirm
  mobileMismatch     Boolean               @default(false) // matched order's customer phone didn't match receiverMobile
  reviewNote         String?

  // Posting (receipt creation)
  postedPaymentId   String?               @unique
  postedAt          DateTime?
  postedById        String?

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  session         RemittanceImportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matchedOrder    Order?                  @relation("RemittanceMatchedOrder", fields: [matchedOrderId], references: [id])
  suggestedOrder  Order?                  @relation("RemittanceSuggestedOrder", fields: [suggestedOrderId], references: [id])
  postedPayment   Payment?                @relation("RemittancePostedPayment", fields: [postedPaymentId], references: [id])
  postedBy        User?                   @relation("RemittancePostedBy", fields: [postedById], references: [id])

  @@index([sessionId])
  @@index([matchStatus])
  @@index([awbNumber])
}

enum RemittanceMatchStatus {
  NEEDS_REVIEW
  MATCHED
  POSTED
  DUPLICATE
  REJECTED
}

model VendorKeyword {
  id        String   @id @default(cuid())
  keyword   String   @unique
  vendorId  String
  createdAt DateTime @default(now())
  vendor    Vendor   @relation("VendorKeywords", fields: [vendorId], references: [id], onDelete: Cascade)
}

// Bank Statement > Employee Keywords — same convention as VendorKeyword /
// ExpenseKeyword above, but for staff. A DR bank transaction whose
// description contains one of a user's keywords (e.g. how their name
// appears in bank narration) is auto-tagged as that user's salary payment
// (BankTransaction.salaryForUserId + MATCHED_SALARY, see
// migration 20260725100000_add_salary_bank_tagging) at import time, the
// same way vendor/expense keywords auto-tag matchedVendorId/expenseCategoryId.
model UserPaymentKeyword {
  id        String   @id @default(cuid())
  keyword   String   @unique
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation("UserPaymentKeywords", fields: [userId], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  id           String            @id @default(cuid())
  name         String            @unique
  description  String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  keywords     ExpenseKeyword[]
  transactions BankTransaction[]
}

model ExpenseKeyword {
  id         String          @id @default(cuid())
  keyword    String          @unique
  categoryId String
  createdAt  DateTime        @default(now())
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

enum BankImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum BankTxnType {
  CR
  DR
}

enum BankReconcileStatus {
  UNMATCHED
  MATCHED_PAYMENT
  MATCHED_VENDOR
  MATCHED_EXPENSE
  MATCHED_COMMISSION
  MATCHED_SALARY
  MANUAL_REVIEW
  IGNORED
}

// ── In-House Sticker Stock (12×18 sheets printed in office) ─────────────────
model InHouseStickerStock {
  id            String   @id @default(cuid())
  balanceSheets Int      @default(0) // current balance of 12x18 sticker sheets
  updatedAt     DateTime @updatedAt
}

model InHouseStickerTransaction {
  id              String               @id @default(cuid())
  transactionType InHouseStickerTxType
  sheets          Int // positive = IN, negative = OUT
  balanceAfter    Int
  referenceId     String? // e.g. job/order ID when used
  notes           String?
  createdAt       DateTime             @default(now())

  @@index([createdAt])
}

enum InHouseStickerTxType {
  STOCK_IN // sheets added to stock
  USED // sheets consumed for in-house jobs
  ADJUSTMENT // manual correction
}

// ── Business Rules ───────────────────────────────────────────────────────────
model BusinessRule {
  id          String   @id @default(cuid())
  ruleCode    String   @unique // e.g. "DISPATCH-001"
  module      String   // ORDERS | ACCOUNTS | PRODUCTION | DISPATCH | SYSTEM
  title       String
  description String
  example     String
  severity    String   // CRITICAL | HIGH | MEDIUM
  testedBy    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module])
  @@index([active])
}

// ── User Activity Tracking ───────────────────────────────────────────────────
model UserActivitySession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserActivitySessions", fields: [userId], references: [id], onDelete: Cascade)
  page          String   @default("/")
  startedAt     DateTime @default(now())
  lastPingAt    DateTime @default(now())
  activeSeconds Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([startedAt])
}

// ── Complaint / Ticket Management (see complaint-ticket-module-spec.md) ─────

enum ComplaintChannel {
  WHATSAPP
  CALL
  EMAIL
  WEB_PORTAL
  WALK_IN
  SALES_AGENT
}

enum ComplaintCategory {
  PRODUCT_QUALITY
  DELIVERY_DELAY
  WRONG_ITEM
  DAMAGED_IN_TRANSIT
  DESIGN_ERROR
  PRODUCTION_DEFECT
  BILLING_DISPUTE
  PAYMENT_ISSUE
  VENDOR_ISSUE
  SERVICE_COMPLAINT
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_CUSTOMER
  PENDING_VENDOR
  RESOLVED
  CLOSED
  REOPENED
}

enum ComplaintResolutionType {
  REPRINT
  REFUND
  PARTIAL_REFUND
  REPLACEMENT
  DISCOUNT_CREDIT
  APOLOGY_ONLY
  NO_FAULT_FOUND
  GOODWILL
}

enum ComplaintCommentVisibility {
  INTERNAL
  CUSTOMER
}

model Complaint {
  id                 String                   @id @default(cuid())
  ticketNumber       String                   @unique // CMP-2026-00001
  customerId         String
  orderId            String?
  orderItemId        String?
  productId          String?
  channel            ComplaintChannel
  category           ComplaintCategory
  priority           ComplaintPriority        @default(MEDIUM)
  status             ComplaintStatus          @default(OPEN)
  subject            String
  description        String

  raisedById         String?                  // staff who logged it (null if customer self-service)
  assignedToId       String?
  assignedTeam       String?                  // "PRODUCTION" | "DISPATCH" | "ACCOUNTS" | "DESIGN" | "SALES"

  slaResponseDueAt   DateTime?
  slaResolutionDueAt DateTime?
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?

  resolutionType     ComplaintResolutionType?
  resolutionNotes    String?
  rootCause          String?
  vendorId           String?                  // set if root cause traces to a job-work vendor

  reopenCount        Int                      @default(0)
  escalatedToAdmin   Boolean                  @default(false)
  escalatedAt        DateTime?

  csatRating         Int?                     // 1-5, captured after CLOSED
  csatFeedback       String?

  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  customer           Customer                 @relation(fields: [customerId], references: [id])
  order              Order?                   @relation(fields: [orderId], references: [id])
  raisedBy           User?                    @relation("ComplaintRaisedBy", fields: [raisedById], references: [id])
  assignedTo         User?                    @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id])
  vendor             Vendor?                  @relation(fields: [vendorId], references: [id])
  comments           ComplaintComment[]
  attachments        ComplaintAttachment[]
  statusLogs         ComplaintStatusLog[]

  @@index([status, priority])
  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([assignedToId, status])
  @@index([slaResolutionDueAt, status])
}

model ComplaintComment {
  id           String                     @id @default(cuid())
  complaintId  String
  authorId     String?                    // null = customer/system message
  authorName   String
  visibility   ComplaintCommentVisibility @default(INTERNAL)
  message      String
  createdAt    DateTime                   @default(now())

  complaint    Complaint                  @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
}

model ComplaintAttachment {
  id           String    @id @default(cuid())
  complaintId  String
  url          String
  fileName     String
  fileType     String?
  uploadedById String?
  createdAt    DateTime  @default(now())

  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model ComplaintStatusLog {
  id          String           @id @default(cuid())
  complaintId String
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus
  changedById String?
  reason      String?
  createdAt   DateTime         @default(now())

  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
}
