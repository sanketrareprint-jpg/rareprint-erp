         is_Ndd: 0,
         order_Amount: input.orderAmount,
         tax_Amount: 0,
-        extra_Charges: 0,
+        extra_Charges: input.extraCharges ?? 0,
         total_Amount: input.totalAmount,
         cod_Amount: input.isCod ? input.codAmount : 0,
         shipment_Weight: input.weightKg,